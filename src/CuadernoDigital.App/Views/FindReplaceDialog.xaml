<Window x:Class="CuadernoDigital.App.Views.FindReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Buscar y reemplazar"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Border Style="{StaticResource CardBorderStyle}"
            Width="420"
            Margin="16">
        <StackPanel>
            <TextBlock Text="Buscar y reemplazar"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14" />
            <TextBlock Text="Buscar"
                       Foreground="{StaticResource TextMutedBrush}" />
            <ui:TextBox x:Name="FindBox"
                        PlaceholderText="Texto a buscar"
                        Margin="0,4,0,12" />
            <TextBlock Text="Reemplazar por"
                       Foreground="{StaticResource TextMutedBrush}" />
            <ui:TextBox x:Name="ReplaceBox"
                        PlaceholderText="Nuevo texto"
                        Margin="0,4,0,12" />
            <CheckBox x:Name="MatchCaseBox"
                      Content="Distinguir mayusculas"
                      Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button Content="Cancelar"
                           MinWidth="92"
                           IsCancel="True" />
                <ui:Button Content="Reemplazar"
                           MinWidth="104"
                           Appearance="Primary"
                           Click="Replace_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
