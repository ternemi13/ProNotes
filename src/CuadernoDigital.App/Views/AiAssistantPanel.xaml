<UserControl x:Class="CuadernoDigital.App.Views.AiAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CuadernoDigital.App.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="360" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="18"
                Background="#F8FAFC"
                Padding="6">
            <ListBox x:Name="MessagesList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                MaxWidth="455">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Setter Property="BorderBrush" Value="#BFDBFE" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Foreground="#2563EB"
                                           FontWeight="SemiBold"
                                           FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Tu" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                    <Setter Property="Text" Value="Gemini" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <controls:MarkdownViewer Markdown="{Binding Text}"
                                                         Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ItemsControl x:Name="AttachmentsList"
                              Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F1F5F9"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <ui:Button Icon="{ui:SymbolIcon Dismiss20}"
                                               Width="30"
                                               Height="30"
                                               CornerRadius="15"
                                               Padding="0"
                                               Tag="{Binding}"
                                               Click="RemoveAttachment_Click"
                                               DockPanel.Dock="Right" />
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#475569" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:TextBox x:Name="PromptBox"
                            Grid.Row="1"
                            Height="82"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            PlaceholderText="Escribe tu pregunta..."
                            ClearButtonEnabled="False"
                            BorderThickness="0"
                            PreviewKeyDown="PromptBox_PreviewKeyDown" />
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="AttachButton"
                               Content="Adjuntar"
                               Icon="{ui:SymbolIcon Attach20}"
                               Click="AttachFiles_Click" />
                    <TextBlock x:Name="StatusText"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               Foreground="#64748B"
                               Margin="10,0"
                               VerticalAlignment="Center" />
                    <ui:Button x:Name="SendButton"
                               Grid.Column="2"
                               Icon="{ui:SymbolIcon Send20}"
                               ToolTip="Enviar"
                               Appearance="Primary"
                               Width="44"
                               Height="40"
                               CornerRadius="20"
                               Padding="0"
                               Click="Send_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
