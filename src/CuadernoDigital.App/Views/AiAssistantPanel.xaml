<UserControl x:Class="CuadernoDigital.App.Views.AiAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CuadernoDigital.App.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Asistente IA"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <ui:Button x:Name="ConfigureButton"
                       Content="Clave"
                       Icon="{ui:SymbolIcon Key20}"
                       MinWidth="72"
                       HorizontalAlignment="Right"
                       DockPanel.Dock="Right"
                       Click="ConfigureKey_Click" />
        </DockPanel>

        <Border Grid.Row="1"
                BorderBrush="#D8DEE9"
                BorderThickness="1"
                Background="#F8FAFC">
            <ListBox x:Name="MessagesList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Foreground="#2563EB"
                                           FontWeight="SemiBold"
                                           FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Tu" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                    <Setter Property="Text" Value="Gemini" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <controls:MarkdownViewer Markdown="{Binding Text}"
                                                         Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,10,0,0">
            <ItemsControl x:Name="AttachmentsList"
                          Margin="4,0,4,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                            <ui:Button Icon="{ui:SymbolIcon Dismiss20}"
                                       Width="32"
                                       Padding="0"
                                       Tag="{Binding}"
                                       Click="RemoveAttachment_Click"
                                       DockPanel.Dock="Right" />
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#475569" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:TextBox x:Name="PromptBox"
                        Height="82"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        PlaceholderText="Escribe tu pregunta..."
                        ClearButtonEnabled="False"
                        PreviewKeyDown="PromptBox_PreviewKeyDown" />
            <WrapPanel HorizontalAlignment="Right"
                       Margin="0,4,0,0">
                <ui:Button x:Name="AttachButton"
                           Content="Adjuntar"
                           Icon="{ui:SymbolIcon Attach20}"
                           Click="AttachFiles_Click" />
                <ui:Button x:Name="SendButton"
                           Icon="{ui:SymbolIcon Send20}"
                           ToolTip="Enviar"
                           Appearance="Primary"
                           Click="Send_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       Foreground="#64748B"
                       Margin="4,6,4,0" />
        </StackPanel>
    </Grid>
</UserControl>
