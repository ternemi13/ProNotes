<UserControl x:Class="CuadernoDigital.App.Views.AiAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Asistente IA"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <Button x:Name="ConfigureButton"
                    Content="Clave"
                    MinWidth="72"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="ConfigureKey_Click" />
        </DockPanel>

        <Border Grid.Row="1"
                BorderBrush="#D8DEE9"
                BorderThickness="1"
                Background="#F8FAFC">
            <ListBox x:Name="MessagesList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Foreground="#2563EB"
                                           FontWeight="SemiBold"
                                           FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Tu" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="assistant">
                                                    <Setter Property="Text" Value="Gemini" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Foreground="#0F172A"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,10,0,0">
            <ItemsControl x:Name="AttachmentsList"
                          Margin="4,0,4,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="X"
                                    Width="28"
                                    Padding="0"
                                    Tag="{Binding}"
                                    Click="RemoveAttachment_Click"
                                    DockPanel.Dock="Right" />
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#475569" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="PromptBox"
                     Height="74"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="PromptBox_PreviewKeyDown"
                     ToolTip="Escribe una pregunta para el asistente" />
            <WrapPanel HorizontalAlignment="Right"
                       Margin="0,4,0,0">
                <Button x:Name="AttachButton"
                        Content="Adjuntar"
                        Click="AttachFiles_Click" />
                <Button x:Name="SendButton"
                        Content="Enviar"
                        Click="Send_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       Foreground="#64748B"
                       Margin="4,6,4,0" />
        </StackPanel>
    </Grid>
</UserControl>
