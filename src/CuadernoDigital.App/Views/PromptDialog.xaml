<Window x:Class="CuadernoDigital.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProNotes"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="18" Width="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="QuestionText"
                   FontSize="15"
                   TextWrapping="Wrap"
                   Margin="4,0,4,8" />
        <TextBox x:Name="AnswerBox"
                 Grid.Row="1"
                 MinWidth="320"
                 KeyDown="AnswerBox_KeyDown" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancelar"
                    IsCancel="True"
                    MinWidth="86" />
            <Button Content="Aceptar"
                    IsDefault="True"
                    MinWidth="86"
                    Click="Accept_Click" />
        </StackPanel>
    </Grid>
</Window>
