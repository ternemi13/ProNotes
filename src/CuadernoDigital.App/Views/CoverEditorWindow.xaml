<Window x:Class="CuadernoDigital.App.Views.CoverEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CuadernoDigital.App.Views"
        Title="Editar portada"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="White"
                Padding="14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        MinWidth="96"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="Guardar cambios"
                        MinWidth="132"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Border>

        <local:CoverDesignerView x:Name="Designer" />
    </DockPanel>
</Window>
