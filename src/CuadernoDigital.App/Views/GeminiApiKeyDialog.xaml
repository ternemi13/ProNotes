<Window x:Class="CuadernoDigital.App.Views.GeminiApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clave de Gemini"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="18" Width="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Configura tu API key de Gemini"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="4,0,4,8" />
        <TextBlock x:Name="HelpText"
                   Grid.Row="1"
                   TextWrapping="Wrap"
                   Foreground="#475569"
                   Margin="4,0,4,10" />
        <PasswordBox x:Name="ApiKeyBox"
                     Grid.Row="2"
                     MinWidth="360"
                     Padding="8,5" />
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="ClearButton"
                    Content="Quitar"
                    MinWidth="84"
                    Click="Clear_Click" />
            <Button Content="Cancelar"
                    IsCancel="True"
                    MinWidth="84" />
            <Button Content="Guardar"
                    IsDefault="True"
                    MinWidth="84"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
