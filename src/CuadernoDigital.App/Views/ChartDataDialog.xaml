<Window x:Class="CuadernoDigital.App.Views.ChartDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grafica"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="18" Width="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Datos de la grafica"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="4,0,4,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="4">
                <TextBlock Text="Titulo" Margin="0,0,0,4" />
                <TextBox x:Name="TitleBox" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="4">
                <TextBlock Text="Tipo" Margin="0,0,0,4" />
                <ComboBox x:Name="TypeBox" SelectedIndex="0" SelectionChanged="Input_Changed">
                    <ComboBoxItem Content="Barras" Tag="Bar" />
                    <ComboBoxItem Content="Lineas" Tag="Line" />
                    <ComboBoxItem Content="Circular" Tag="Pie" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="4">
                <TextBlock Text="Datos" Margin="0,0,0,4" />
                <TextBox x:Name="DataBox"
                         Height="190"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="Input_Changed" />
                <TextBlock Text="Un dato por linea: etiqueta, valor"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="4,4,4,0" />
            </StackPanel>

            <Border Grid.Column="1"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="4">
                <Grid x:Name="PreviewHost"
                      Width="300"
                      Height="190" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancelar"
                    IsCancel="True"
                    MinWidth="86" />
            <Button Content="Aceptar"
                    IsDefault="True"
                    MinWidth="86"
                    Click="Accept_Click" />
        </StackPanel>
    </Grid>
</Window>
