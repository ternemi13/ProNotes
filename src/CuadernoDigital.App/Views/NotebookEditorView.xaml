<Window x:Class="CuadernoDigital.App.Views.NotebookEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:CuadernoDigital.App.Models"
        Title="{Binding Notebook.Title}"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="620"
        Background="#EEF2F7"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Background="White"
                   LastChildFill="True">
            <StackPanel DockPanel.Dock="Left"
                        Orientation="Horizontal"
                        Margin="10"
                        VerticalAlignment="Center">
                <Button Content="Guardar" Command="{Binding SaveCommand}" />
                <Button Content="Renombrar" Command="{Binding RenameCommand}" />
                <Button Content="Deshacer" Click="Undo_Click" />
                <Button Content="Rehacer" Click="Redo_Click" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Margin="10"
                        VerticalAlignment="Center">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,2,0" />
                <Slider Width="120"
                        Minimum="0.5"
                        Maximum="2.2"
                        Value="{Binding Zoom, ElementName=CanvasView, Mode=TwoWay}"
                        TickFrequency="0.1" />
            </StackPanel>

            <WrapPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <Button Content="Lapiz" Click="Pen_Click" />
                <Button Content="Resaltador" Click="Highlighter_Click" />
                <Button Content="Borrador" Click="Eraser_Click" />
                <Button Content="Cursor" Click="Cursor_Click" />
                <Button Content="Texto" Click="InsertText_Click" />
                <Button Content="Tabla" Click="InsertTable_Click" />
                <Button Content="Grafica" Click="InsertChart_Click" />
                <Button Content="Imagen" Click="InsertImage_Click" />
                <ComboBox x:Name="InkColorBox"
                          Width="118"
                          SelectedIndex="0"
                          SelectionChanged="InkSettings_Changed">
                    <ComboBoxItem Content="Negro" Tag="#111827" />
                    <ComboBoxItem Content="Azul" Tag="#2563EB" />
                    <ComboBoxItem Content="Rojo" Tag="#DC2626" />
                    <ComboBoxItem Content="Verde" Tag="#16A34A" />
                    <ComboBoxItem Content="Amarillo" Tag="#FACC15" />
                </ComboBox>
                <TextBlock Text="Grosor" VerticalAlignment="Center" Margin="10,0,2,0" />
                <Slider x:Name="InkWidthSlider"
                        Width="110"
                        Minimum="1"
                        Maximum="18"
                        Value="3"
                        ValueChanged="InkSettings_Changed" />
                <Separator Width="1" Height="24" Margin="8,0" Background="#CBD5E1" />
                <Button Content="B" FontWeight="Bold" Click="Bold_Click" />
                <Button Content="I" FontStyle="Italic" Click="Italic_Click" />
                <Button Content="U" Click="Underline_Click" />
                <ComboBox x:Name="TextSizeBox"
                          Width="72"
                          SelectedIndex="2"
                          SelectionChanged="TextSize_Changed">
                    <ComboBoxItem Content="12" />
                    <ComboBoxItem Content="16" />
                    <ComboBoxItem Content="18" />
                    <ComboBoxItem Content="24" />
                    <ComboBoxItem Content="32" />
                </ComboBox>
                <ComboBox x:Name="TextColorBox"
                          Width="118"
                          SelectedIndex="0"
                          SelectionChanged="TextColor_Changed">
                    <ComboBoxItem Content="Negro" Tag="#111827" />
                    <ComboBoxItem Content="Azul" Tag="#2563EB" />
                    <ComboBoxItem Content="Rojo" Tag="#DC2626" />
                    <ComboBoxItem Content="Verde" Tag="#16A34A" />
                </ComboBox>
                <Button Content="Izq" Click="AlignLeft_Click" />
                <Button Content="Centro" Click="AlignCenter_Click" />
                <Button Content="Der" Click="AlignRight_Click" />
                <Separator Width="1" Height="24" Margin="8,0" Background="#CBD5E1" />
                <Button Content="Fila +" Click="AddTableRow_Click" />
                <Button Content="Fila -" Click="RemoveTableRow_Click" />
                <Button Content="Col +" Click="AddTableColumn_Click" />
                <Button Content="Col -" Click="RemoveTableColumn_Click" />
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="White"
                BorderBrush="#D8DEE9"
                BorderThickness="0,1,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10">
                    <Button Content="Agregar pagina" Command="{Binding AddPageCommand}" />
                    <Button Content="Eliminar pagina" Command="{Binding DeletePageCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}"
                         BorderThickness="0"
                         Margin="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NotebookPage}">
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding BackgroundType}" Foreground="#64748B" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <local:PageCanvasView x:Name="CanvasView"
                              xmlns:local="clr-namespace:CuadernoDigital.App.Views"
                              Grid.Row="1"
                              Grid.Column="1"
                              CurrentPage="{Binding SelectedPage}"
                              PageChanged="CanvasView_PageChanged" />

        <Border Grid.Row="1"
                Grid.Column="2"
                Background="White"
                BorderBrush="#D8DEE9"
                BorderThickness="1,1,0,0"
                Padding="14">
            <StackPanel>
                <TextBlock Text="Pagina"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="4,0,0,10" />
                <TextBlock Text="Fondo" Margin="4,0,0,2" />
                <ComboBox ItemsSource="{Binding BackgroundTypes}"
                          SelectedItem="{Binding SelectedPage.BackgroundType, Mode=TwoWay}"
                          SelectionChanged="Background_SelectionChanged" />

                <Separator Margin="0,14" />
                <TextBlock Text="Asistente IA"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="4,0,0,8" />
                <TextBlock Text="Listo para Fase 7: chat Gemini y revision de pagina."
                           TextWrapping="Wrap"
                           Foreground="#64748B"
                           Margin="4" />
                <Button Content="Configurar despues" IsEnabled="False" />

                <Separator Margin="0,14" />
                <TextBlock Text="Objetos"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="4,0,0,8" />
                <TextBlock Text="Texto, tablas, graficas e imagenes activos. Usa la barra, Ctrl+V o click derecho. Selecciona objetos para mover, duplicar, rotar, ordenar o eliminar."
                           TextWrapping="Wrap"
                           Foreground="#64748B"
                           Margin="4" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2"
                   Grid.ColumnSpan="3"
                   Background="White"
                   LastChildFill="False">
            <TextBlock Text="{Binding FilePath}"
                       Foreground="#64748B"
                       Margin="12,8"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock DockPanel.Dock="Right"
                       Margin="12,8"
                       Foreground="#64748B">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Guardado" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                <Setter Property="Text" Value="Cambios sin guardar" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Grid>
</Window>
