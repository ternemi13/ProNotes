<Window x:Class="CuadernoDigital.App.Views.ImageCropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recortar imagen"
        Width="820"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Recortar antes de insertar"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       DockPanel.Dock="Left" />
            <TextBlock x:Name="ImageSizeText"
                       Foreground="#64748B"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       DockPanel.Dock="Right" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Padding="12">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Image x:Name="OriginalImage"
                           Stretch="None"
                           SnapsToDevicePixels="True" />
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Padding="12">
                <DockPanel>
                    <TextBlock Text="Vista previa"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,0,0,8"
                               DockPanel.Dock="Top" />
                    <Border Background="#F1F5F9"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Margin="8" />
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="X" VerticalAlignment="Center" />
                <Slider x:Name="CropXSlider"
                        Grid.Column="1"
                        Minimum="0"
                        ValueChanged="CropSlider_Changed" />

                <TextBlock Grid.Row="1" Text="Y" VerticalAlignment="Center" />
                <Slider x:Name="CropYSlider"
                        Grid.Row="1"
                        Grid.Column="1"
                        Minimum="0"
                        ValueChanged="CropSlider_Changed" />

                <TextBlock Grid.Row="2" Text="Ancho" VerticalAlignment="Center" />
                <Slider x:Name="CropWidthSlider"
                        Grid.Row="2"
                        Grid.Column="1"
                        Minimum="1"
                        ValueChanged="CropSlider_Changed" />

                <TextBlock Grid.Row="3" Text="Alto" VerticalAlignment="Center" />
                <Slider x:Name="CropHeightSlider"
                        Grid.Row="3"
                        Grid.Column="1"
                        Minimum="1"
                        ValueChanged="CropSlider_Changed" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2"
                   Margin="0,14,0,0"
                   LastChildFill="False">
            <TextBlock x:Name="CropInfoText"
                       Foreground="#64748B"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <Button Content="Usar completa"
                        MinWidth="110"
                        Click="UseFullImage_Click" />
                <Button Content="Cancelar"
                        MinWidth="92"
                        IsCancel="True" />
                <Button Content="Insertar"
                        MinWidth="92"
                        IsDefault="True"
                        Click="Insert_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
